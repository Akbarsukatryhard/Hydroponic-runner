function drawStory(){const i=ST.sc,k=i>4?4:i,u=i>4?1:ST.u,dir=k%2?1:-1;g.save();const z=RM?1.04:1.05+.06*u;g.translate(W/2,H/2);g.scale(z,z);g.translate(-W/2+(RM?0:(.5-u)*28*dir),-H/2);[S0,S1,S2,S3,S4][k](u,ST.t);g.restore();
