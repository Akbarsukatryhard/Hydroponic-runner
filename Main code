<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"><title>Hydroponic Runner</title>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Cormorant+SC:wght@500;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#05060a;--tx:#dfe6ee;--gl:#fff;--ac:#8fd9a8;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root{--bg:#05060a}}
html,body{height:100%;margin:0;background:var(--bg);color:var(--tx);font-family:'Cormorant Garamond',Georgia,serif;font-size:18px;overflow:hidden;-webkit-user-select:none;user-select:none;touch-action:manipulation}
#c{position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);width:min(100vw,200vh);aspect-ratio:2/1;background:#000}
#fx{position:fixed;inset:0;width:100%;height:100%;z-index:20;pointer-events:none}
.scr{position:fixed;inset:0;display:none;flex-direction:column;align-items:center;justify-content:center;gap:10px;padding:16px;overflow:auto;z-index:10;text-align:center;background:radial-gradient(ellipse at 50% 35%,rgba(80,90,110,.35),rgba(4,5,8,.95) 72%)}
.scr.on{display:flex}
h1,h2{font-family:'Cormorant SC',Georgia,serif;font-weight:600;margin:0;text-shadow:0 0 14px #fff,0 0 34px rgba(200,220,255,.6);color:var(--gl);letter-spacing:.06em}
h1{font-size:clamp(34px,9vw,70px);line-height:1}h2{font-size:clamp(26px,6vw,40px)}
.orn{display:flex;align-items:center;gap:10px;width:min(420px,80vw);color:#fff;text-shadow:0 0 10px #fff}
.orn:before,.orn:after{content:"";flex:1;height:1px;background:linear-gradient(90deg,transparent,#fff,transparent)}
button,.btn{font:600 22px 'Cormorant SC',Georgia,serif;color:var(--tx);background:none;border:0;padding:6px 22px;cursor:pointer;letter-spacing:.05em;min-height:40px;transition:text-shadow .2s,color .2s}
button:hover,button.sel{color:#fff;text-shadow:0 0 12px #fff}
button.sel:before{content:"❬ ";}button.sel:after{content:" ❭"}
button:focus-visible{outline:1px solid #fff}
.bx{border:1px solid rgba(255,255,255,.35);border-radius:3px;font-size:19px}
.pn{max-width:min(560px,94vw);width:100%;line-height:1.35}
.pn p{margin:4px 0}.row{display:flex;gap:12px;align-items:center;justify-content:center;flex-wrap:wrap}
.l{display:grid;grid-template-columns:1fr auto;gap:6px 14px;text-align:left;align-items:center;width:100%}
input[type=range]{width:140px;accent-color:#fff}input[type=text]{background:#0c0f14;border:1px solid #556;color:#fff;font:18px Georgia,serif;padding:4px 8px;width:170px}
.card{border:1px solid rgba(255,255,255,.25);padding:6px 12px;margin:3px 0;text-align:left;background:rgba(255,255,255,.04)}
.card.lk{opacity:.45}.big{font-size:30px;color:#fff;text-shadow:0 0 10px #fff}
#tc{position:fixed;left:0;right:0;bottom:calc(14px + env(safe-area-inset-bottom,0px));display:none;justify-content:space-between;padding:0 8px;z-index:15;pointer-events:none}
#tc button{pointer-events:auto;width:min(112px,22vh);height:min(112px,22vh);border-radius:50%;border:2px solid rgba(255,255,255,.55);background:rgba(255,255,255,.14);font-size:42px;padding:0;touch-action:none}
#pz{position:fixed;top:calc(8px + env(safe-area-inset-top,0px));right:8px;z-index:15;display:none;font-size:18px;padding:2px 10px;border:1px solid #889;border-radius:4px}
#toast{position:fixed;top:12px;left:50%;transform:translateX(-50%);z-index:30;background:#10151d;border:1px solid #fff;padding:6px 16px;display:none;text-shadow:0 0 8px #fff;color:#fff}
.bd{display:inline-block;padding:2px 10px;border-radius:3px;font:600 16px 'Cormorant SC',serif}.sm{background:#6b5200;color:#ffe9a0}.lv{background:#0f5a2c;color:#c9ffd8}.dc{background:#5a1414;color:#ffc9c9}
.warn{color:#ff9d8a}.mut{opacity:.7;font-size:16px}
#s-over{background:radial-gradient(ellipse at 50% 42%,rgba(130,0,0,.5),rgba(0,0,0,.97) 68%);box-shadow:inset 0 0 160px 40px #000}#s-over.on{animation:ovin 1.4s ease-out}@keyframes ovin{from{opacity:0;background-color:#600}to{opacity:1}}#s-over h1{color:#ff4a4a;letter-spacing:.14em;text-shadow:0 0 14px #f00,0 0 50px #a00,0 0 90px #500;animation:thr 3s infinite}@keyframes thr{0%,100%{opacity:1;transform:translate(0)}4%{opacity:.4;transform:translate(-3px,1px)}6%{opacity:1;transform:translate(3px,-1px)}8%{opacity:.7}10%{opacity:1;transform:none}55%{opacity:.85}57%{opacity:1}}.sub{color:#c66;font-style:italic;font-size:20px;text-shadow:0 0 8px #800}#s-over .card{border-color:#6a1a1a;background:rgba(40,0,0,.5)}#s-over .bx{border-color:#a33}
.scr.on{animation:sin .5s ease}@keyframes sin{from{opacity:0}to{opacity:1}}
#s-menu{background:radial-gradient(ellipse at 50% 40%,rgba(30,36,56,.15),rgba(3,4,8,.88) 78%)}
#s-menu>*{position:relative;z-index:1}#s-menu>.fog,#s-menu>.rays{position:absolute;z-index:0;pointer-events:none}
.fog{inset:-20% -50%;opacity:0;transition:opacity 4s ease 1s;background:radial-gradient(ellipse 40% 30% at 20% 60%,rgba(170,185,210,.17),transparent 70%),radial-gradient(ellipse 35% 25% at 65% 40%,rgba(150,170,200,.13),transparent 70%),radial-gradient(ellipse 45% 30% at 85% 78%,rgba(190,200,220,.13),transparent 70%);animation:drift 55s ease-in-out infinite alternate}
.fog.f2{background:radial-gradient(ellipse 45% 25% at 40% 75%,rgba(160,175,200,.14),transparent 70%),radial-gradient(ellipse 30% 30% at 80% 30%,rgba(140,160,190,.1),transparent 70%);animation-duration:80s;animation-direction:alternate-reverse}
#s-menu.rv .fog{opacity:1}
.rays{inset:0;opacity:0;background:repeating-linear-gradient(100deg,transparent 0 90px,rgba(220,230,255,.05) 110px 150px,transparent 170px 300px);-webkit-mask-image:linear-gradient(#000,transparent 75%);mask-image:linear-gradient(#000,transparent 75%)}
#s-menu.rv .rays{animation:ray 12s ease-in-out 3s infinite alternate}
@keyframes drift{from{transform:translateX(-7%)}to{transform:translateX(7%)}}@keyframes ray{from{opacity:.15;transform:translateX(-30px)}to{opacity:.9;transform:translateX(30px)}}
#s-menu:not(.rv) h1,#s-menu:not(.rv) .orn,#s-menu:not(.rv) #mn button,#s-menu:not(.rv) #mst{opacity:0}
#s-menu.rv h1{animation:ttl 3.2s ease .3s backwards,pls 6s ease-in-out 3.5s infinite}
#s-menu.rv .orn{animation:rise 1.6s ease 2s backwards}#s-menu.rv #mst{animation:rise 1.6s ease 3.8s backwards}#s-menu.rv #mn button{animation:rise 1.2s ease backwards}
#s-menu.rv #mn button:nth-child(1){animation-delay:2.6s}#s-menu.rv #mn button:nth-child(2){animation-delay:2.8s}#s-menu.rv #mn button:nth-child(3){animation-delay:3.0s}#s-menu.rv #mn button:nth-child(4){animation-delay:3.2s}#s-menu.rv #mn button:nth-child(5){animation-delay:3.4s}#s-menu.rv #mn button:nth-child(6){animation-delay:3.6s}
@keyframes rise{from{opacity:0;transform:translateY(10px)}}@keyframes ttl{from{opacity:0;filter:blur(10px);letter-spacing:.2em;transform:scale(1.05)}}@keyframes pls{50%{text-shadow:0 0 22px #fff,0 0 60px rgba(200,220,255,.8)}}
#mn button{opacity:.78;font-size:24px;transition:opacity .45s,color .45s,text-shadow .45s,transform .45s}
#mn button:before,#mn button:after{content:"❖";display:inline-block;opacity:0;font-size:13px;margin:0 12px;transition:opacity .45s,transform .45s}
#mn button:before{transform:translateX(14px)}#mn button:after{transform:translateX(-14px)}
#mn button.sel{opacity:1;transform:scale(1.08);text-shadow:0 0 8px #fff,0 0 24px rgba(200,220,255,.8)}
#mn button.sel:before,#mn button.sel:after{opacity:1;transform:none;content:"❖"}
#c{transition:transform .9s ease-out}
#intro{position:fixed;inset:0;z-index:18;background:#000;display:none;align-items:center;justify-content:center;transition:opacity 1.8s ease}#intro.on{display:flex}
#intro .ib{display:flex;flex-direction:column;align-items:center;gap:14px;transition:opacity 1.2s}
.it{font:600 clamp(30px,9vw,76px)/1 'Cormorant SC',Georgia,serif;padding-left:.26em;letter-spacing:.14em;color:#fff;text-shadow:0 0 18px #fff,0 0 50px rgba(190,210,255,.6);opacity:0;filter:blur(8px);transition:opacity 2.4s ease,filter 2.4s ease,letter-spacing 4.5s ease}
.ip{font:500 clamp(15px,3.4vw,26px) 'Cormorant SC',Georgia,serif;letter-spacing:.5em;padding-left:.5em;color:#dfe6ee;text-shadow:0 0 10px #fff;opacity:0;transition:opacity 1.6s ease}
.ior{display:flex;align-items:center;gap:12px;width:0;opacity:0;overflow:hidden;color:#fff;text-shadow:0 0 10px #fff;transition:width 2.6s ease,opacity 1.6s ease}.ior i{flex:1;height:1px;background:linear-gradient(90deg,transparent,#fff,transparent)}
#intro.a .it{opacity:1;filter:none;letter-spacing:.26em}#intro.a .ior{width:min(520px,80vw);opacity:1}#intro.b .ip{opacity:.9}#intro.c .ib{opacity:0}
#skip{position:absolute;right:14px;bottom:calc(14px + env(safe-area-inset-bottom,0px));font-size:18px;opacity:.65;border:1px solid rgba(255,255,255,.3);border-radius:3px}
#story{position:fixed;inset:0;z-index:16;display:none;pointer-events:none}#story.on{display:block}
#nar{position:absolute;left:50%;transform:translateX(-50%);bottom:calc(50vh - min(25vw,50vh) + 34px);width:min(86vw,720px);text-align:center;font:italic 500 clamp(18px,3.1vw,28px)/1.35 'Cormorant Garamond',Georgia,serif;color:#f2f5fa;text-shadow:0 0 12px #000,0 0 3px #000,0 0 18px rgba(200,220,255,.35);opacity:0}
#ttl{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;text-align:center;font:600 clamp(26px,6.4vw,58px)/1.2 'Cormorant SC',Georgia,serif;letter-spacing:.12em;color:#fff;text-shadow:0 0 18px #fff,0 0 50px rgba(200,220,255,.6);opacity:0}
#sskip{pointer-events:auto;position:absolute;right:14px;top:calc(10px + env(safe-area-inset-top,0px));font-size:18px;opacity:.7;border:1px solid rgba(255,255,255,.3);border-radius:3px}
#tc{align-items:flex-end}.tcc{display:flex;flex-direction:column;gap:10px}#tc button{width:min(114px,21vh);height:min(114px,21vh);font-size:40px}#bB,#bP{display:none}#tc.boss #bB,#tc.boss #bP{display:block}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
</style></head><body>
<canvas id="c" width="800" height="400"></canvas><canvas id="fx"></canvas>
<button id="pz" aria-label="Pause">❚❚</button><div id="toast"></div>
<div id="tc"><div class="tcc"><button id="bB" aria-label="Blade">⚔</button><button id="bS" aria-label="Slide">▼</button></div><div class="tcc"><button id="bP" aria-label="Seed">❀</button><button id="bJ" aria-label="Jump">▲</button></div></div>

<div id="story"><div id="nar"></div><div id="ttl">EVERY HARVEST BEGINS<br>WITH A JOURNEY.</div><button id="sskip">Skip</button></div><div id="intro"><div class="ib"><div class="ior"><i></i><span>◆</span><i></i></div><div class="it">M! FAKTORIAL</div><div class="ip">PRESENTS</div><div class="ior"><i></i><span>◆</span><i></i></div></div><button id="skip">Skip intro</button></div>
<div class="scr on" id="s-menu"><div class="fog"></div><div class="fog f2"></div><div class="rays"></div><h1>Hydroponic<br>Runner</h1><div class="orn">◆</div>
<div id="mn" class="row" style="flex-direction:column;gap:0">
<button data-a="start">Start Game</button><button data-a="char">Character Select</button><button data-a="set">Settings</button><button data-a="ach">Achievements</button><button data-a="ext">Extras</button><button data-a="quit">Quit Game</button></div>
<div class="mut" id="mst"></div></div>

<div class="scr" id="s-char"><h2>Choose Your Runner</h2><div class="row"><button class="bx" id="cL">❬</button><canvas id="pc" width="200" height="200"></canvas><button class="bx" id="cR">❭</button></div>
<div class="big" id="cn"></div><div class="pn" id="cd"></div><div class="row"><button class="bx" id="cOk">Confirm</button><button data-go="menu">Back</button></div></div>

<div class="scr" id="s-set"><h2>Settings</h2><div class="pn l">
<label for="vm">Master volume</label><input type="range" id="vm" min="0" max="1" step=".05">
<label for="vu">Music volume</label><input type="range" id="vu" min="0" max="1" step=".05">
<label for="vs">Sound effects volume</label><input type="range" id="vs" min="0" max="1" step=".05">
<label for="vo">Audio enabled</label><input type="checkbox" id="vo">
<label for="vt">On-screen touch controls</label><input type="checkbox" id="vt"><label for="vi">Show intro on every launch</label><input type="checkbox" id="vi"><label for="vk">Soundtrack music</label><input type="checkbox" id="vk"></div>
<div class="pn mut">Keys: ↑ / W / Space = jump · ↓ / S = slide · P / Esc = pause. Boss fight: X / K = energy blade, C / L = seed shot (touch: ⚔ and ❀). Touch: ▲ jump, ▼ slide.</div>
<div class="row"><button class="bx" id="vr">Reset settings</button><button data-go="menu">Back</button></div></div>

<div class="scr" id="s-ach"><h2>Achievements</h2><div class="pn" id="al"></div><button data-go="menu">Back</button></div>

<div class="scr" id="s-ext"><h2>Extras</h2><div class="pn">
<div class="card"><b>Pakcoy</b><p>Normal: +1. Golden: +3 and a bonus. Rare: +1 and big EXP.</p></div></div>
<div class="row"><button class="bx" id="eS">Replay story</button><button class="bx" id="eI">Replay intro</button><button class="bx" id="eE">Erase all progress</button><button data-go="menu">Back</button></div></div>

<div class="scr" id="s-over"><h1>Game Over</h1><div class="sub">The darkness claims another runner…</div><canvas id="oc" width="150" height="110"></canvas><div class="pn card" id="os"></div>
<div class="row"><button class="bx" id="oA">Play Again</button><button class="bx" data-go="menu">Back to Main Menu</button></div></div>

<script>
"use strict";
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)],R=(a,b)=>a+Math.random()*(b-a);
const W=800,H=400,GY=330,cv=$('#c'),g=cv.getContext('2d');
/* ===== SettingsManager / persistence ===== */
const DEF={set:{m:1,mu:.5,sf:.8,on:true,tc:true,si:false,mt:true},ch:0,best:0,exp:0,pak:0,ach:{},hist:0,live:0,gold:0};
const S={d:JSON.parse(JSON.stringify(DEF)),
load(){try{const j=JSON.parse(localStorage.getItem('hrun')||'{}');Object.assign(this.d,j);this.d.set=Object.assign({},DEF.set,j.set)}catch(e){}},
save(){try{localStorage.setItem('hrun',JSON.stringify(this.d))}catch(e){}}};S.load();
/* ===== Procedural audio ===== */
const Aud={ctx:null,mode:'menu',n:0,
init(){try{if(!this.ctx)this.ctx=new(window.AudioContext||window.webkitAudioContext)();if(this.ctx.state==='suspended')this.ctx.resume().catch(()=>{})}catch(e){}},
vol(k){const s=S.d.set;return s.on?s.m*(k==='m'?s.mu*(s.mt===false?0:1):s.sf):0},
tone(f,d,ty,k,gn,f2,dl=0){if(!this.ctx)return;const v=this.vol(k);if(!v)return;const t=this.ctx.currentTime+dl,o=this.ctx.createOscillator(),a=this.ctx.createGain();o.type=ty;o.frequency.setValueAtTime(f,t);if(f2)o.frequency.exponentialRampToValueAtTime(f2,t+d);a.gain.setValueAtTime(gn*v,t);a.gain.exponentialRampToValueAtTime(.001,t+d);o.connect(a);a.connect(this.ctx.destination);o.start(t);o.stop(t+d)},
sfx(n){({jump:()=>this.tone(300,.18,'square','s',.12,640),slide:()=>this.tone(220,.22,'sawtooth','s',.08,90),pak:()=>{this.tone(660,.1,'sine','s',.2);this.tone(990,.14,'sine','s',.2,0,.07)},gold:()=>[660,880,1320].forEach((f,i)=>this.tone(f,.2,'triangle','s',.2,0,i*.07)),die:()=>{this.tone(200,.7,'sawtooth','s',.3,40);this.tone(70,.9,'sine','s',.4,30);this.tone(150,1.5,'sawtooth','s',.2,55,.15);this.tone(158,1.5,'sawtooth','s',.15,58,.15);this.tone(40,2,'sine','s',.4,28,.3)},slash:()=>this.tone(900,.2,'sawtooth','s',.1,200),seed:()=>this.tone(500,.1,'sine','s',.12,900),hit:()=>this.tone(160,.15,'square','s',.2,60),boom:()=>this.tone(70,.6,'sawtooth','s',.3,30),ui:()=>this.tone(440,.08,'sine','s',.15),ok:()=>this.tone(560,.14,'triangle','s',.2,840)})[n]?.()},
music(m){this.mode=m},
stopAll(){try{this.ctx&&this.ctx.close()}catch(e){}this.ctx=null},hope:false,
step(){this.n++;if(this.mode==='intro')return;const hp=this.hope,C=hp?[[262,330,392],[196,247,294],[220,262,330],[175,220,262]]:[[220,262,330],[175,220,262],[262,330,392],[196,247,294]],n=this.n,ch=C[(n>>4)%4],gm=this.mode==='game'||this.mode==='boss';
if(n%16===0){ch.forEach((f,i)=>{this.tone(f,6.4,'sine','m',.06,0,i*.12);this.tone(f*1.004,6.4,'sine','m',.04,0,i*.12)});this.tone(ch[0]/2,6.4,'triangle','m',.07)}
const ev=gm?2:4;if(n%ev===0)this.tone(ch[(n/ev|0)%3]*(n%32<16?2:1),1.8,'triangle','m',.045);
if(hp&&n%8===4)this.tone(ch[2]*2,1.2,'sine','m',.03)}};
setInterval(()=>Aud.ctx&&Aud.step(),330);
/* ===== Characters ===== */
const CH=[{n:'The Warden',d:'A pale-masked guardian of the greenhouse halls. Calm and steady.',c:'#e8eef2',a:'#7d92a3'},{n:'Sprout',d:'A small leaf-crowned grower who tends every plant with care.',c:'#b5eaa0',a:'#2f7d3f'},{n:'Ember',d:'A lantern bearer who lights the dark streets for others.',c:'#f0c090',a:'#9c3d28'}];
/* ===== Character rig: jointed body, per-state poses, blended transitions ===== */
const P0=()=>({by:0,tilt:0,sx:1,sy:1,rot:0,l1:0,k1:0,l2:0,k2:0,a1:.15,e1:.3,a2:-.15,e2:.3,hr:0,ey:0,bl:0});
const PKEYS=['by','tilt','sx','sy','rot','l1','k1','l2','k2','a1','e1','a2','e2','hr'];
const ez=(a,b,k)=>a+(b-a)*k;
function poseFor(st,t,x){x=x||{};const P=P0(),s=Math.sin,ph=t*(x.sp||13);
if(st==='run'){const b=s(ph);Object.assign(P,{l1:b*.95,k1:Math.max(0,-s(ph+1.4))*1.2+.2,l2:-b*.95,k2:Math.max(0,s(ph+1.4))*1.2+.2,by:-Math.abs(s(ph))*3.2,tilt:.14,a1:-b*.95,e1:.9,a2:b*.95,e2:.9,hr:-.05+s(ph*2)*.03,sy:1+s(ph*2)*.02})}
else if(st==='ant')Object.assign(P,{sy:.84,sx:1.1,l1:.5,k1:1,l2:.3,k2:1,tilt:.2,a1:-.8,a2:-.6,e1:.2,e2:.2,ey:3});
else if(st==='jump')Object.assign(P,{sy:1.1,sx:.93,l1:.7,k1:.9,l2:-.2,k2:.6,a1:2.2,e1:.2,a2:1.6,e2:.2,tilt:.05,ey:3});
else if(st==='fall')Object.assign(P,{sy:1.04,l1:.3,k1:.3,l2:-.3,k2:.2,a1:1.5+s(t*14)*.1,e1:.2,a2:-1.2,e2:.2,tilt:-.05,hr:-.1});
else if(st==='land'){const k=x.lt==null?.5:x.lt;Object.assign(P,{sy:1-.22*k,sx:1+.14*k,l1:.6*k,k1:1.1*k,l2:.4*k,k2:1.1*k,tilt:.15*k,a1:.5*k,a2:-.4*k})}
else if(st==='slide')Object.assign(P,{rot:-1.35,by:10,l1:.2,k1:.1,l2:.4,k2:.2,a1:-.6,e1:.2,a2:-.9,e2:.2,hr:.1,ey:3});
else if(st==='victory')Object.assign(P,{a1:2.9,a2:2.7,e1:.1,e2:.1,by:-Math.abs(s(t*6))*6,sy:1+s(t*12)*.03,l1:.2,l2:-.2,ey:1});
else if(st==='dead')Object.assign(P,{rot:1.45,by:12,l1:.4,k1:.8,l2:-.3,k2:.5,a1:1,a2:-1,ey:2});
else Object.assign(P,{by:s(t*2)*.7,sy:1+s(t*2)*.012,a1:.12+s(t*2)*.06,a2:-.1,hr:s(t*.7)*.04,l1:.04,l2:-.04});
if(x.hurt>0){const h=x.hurt;P.tilt-=.3*h;P.ey=2;P.a1=ez(P.a1,1.7,h);P.a2=ez(P.a2,-1.4,h);P.hr-=.15*h}
if(x.col>0){P.a1=ez(P.a1,2.7,x.col);P.e1=ez(P.e1,.15,x.col);P.ey=1;P.hr=-.12*x.col;P.sy*=1+.05*x.col}
if(x.atk>=0){P.a1=-1.7+x.atk*3.5;P.e1=.15;P.tilt=Math.max(P.tilt,.18);P.ey=3;P.bl=1}
