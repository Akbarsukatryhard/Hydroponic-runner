g.fillStyle='#000';g.fillRect(0,0,W,24);g.fillRect(0,H-24,W,24);g.fillStyle='rgba(0,0,0,'+ST.fa+')';g.fillRect(0,0,W,H)}
function stUpd(dt){if(!ST.on)return;const nar=$('#nar'),tt=$('#ttl');
if(ST.sk>0){ST.sk-=dt;ST.fa=1-Math.max(0,ST.sk)/.6;nar.style.opacity=0;tt.style.opacity=0;if(ST.sk<=0)finishStory();return}
ST.t+=dt;if(ST.t>=ST.total){finishStory();return}
let t=ST.t,i=0;while(i<5&&t>=SD[i]){t-=SD[i];i++}ST.sc=i;ST.u=t/SD[i];
if(i!==ST.i){ST.i=i;nar.textContent=SN[i];if(i===3)Aud.hope=true}
const d=SD[i];ST.fa=i===5?1-cl(Math.min(t/.8,(d-t)/1)):1-cl(Math.min(t/.8,(d-t)/.8));
nar.style.opacity=i<5?cl(Math.min(t-.9,d-.8-t)/.9):0;tt.style.opacity=i===5?cl(Math.min(t-.6,d-t-.4)/1.2):0}
