for(let i=0;i<4;i++){const x=480+i*60;if(a>.9){g.fillStyle='#151515';g.fillRect(x-9,GY-68,18,8);if(u>.3&&m<.3){g.strokeStyle='#5c5';g.lineWidth=3;g.beginPath();g.moveTo(x,GY-68);g.lineTo(x,GY-68-gr*18);g.stroke();g.fillStyle='#6d6';g.beginPath();g.ellipse(x-5,GY-70-gr*16,2+gr*4,1.5+gr*3,-.5,0,7);g.ellipse(x+5,GY-70-gr*16,2+gr*4,1.5+gr*3,.5,0,7);g.fill()}if(m>0){g.save();g.translate(x,GY-62);g.scale(.35+.65*m,.35+.65*m);dP({x:0,y:-8,t:0,ph:i},T);g.restore()}}}
chr(340,GY-6,'idle',T,0);if(u>.78){glow(362,GY-52,70,'255,225,130',.3);dP({x:362,y:GY-52+Math.sin(T*3)*2,t:0,ph:0},T)}}
function S4(u,T){const s=g.createLinearGradient(0,0,0,GY);s.addColorStop(0,'#1d2147');s.addColorStop(.7,'#9a5a62');s.addColorStop(1,'#e8a066');g.fillStyle=s;g.fillRect(-40,-40,W+80,GY+40);glow(620,GY-20,340,'255,190,120',.45);
for(let L=0;L<2;L++)for(let i=0;i<11;i++){const x=i*85-u*(L?70:35)-30,h=(L?70:110)+((i*53+L*31)%90);g.fillStyle=L?'#17131f':'#251e33';g.fillRect(x,GY-h,70,h);g.fillStyle='#ffd49a';g.globalAlpha=.55;for(let r=0;r<h/18-1|0;r++)for(let c=0;c<4;c++)if(Math.sin(i*7+r*3.1+c*5.3+L)>.4)g.fillRect(x+8+c*15,GY-h+8+r*18,6,8);g.globalAlpha=1}
