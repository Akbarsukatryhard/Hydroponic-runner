function S0(u,T){room(T);lamp(540,T);chr(520,GY-6,'idle',T,.04+Math.sin(T*.8)*.015);tbl(440,220);g.fillStyle='#cfc6b4';g.fillRect(462,GY-46,24,5);g.fillRect(492,GY-45,18,4);g.fillStyle='#4a4a4f';g.beginPath();g.ellipse(620,GY-42,16,6,0,0,Math.PI);g.fill();g.fillStyle='#ffcf86';g.fillRect(573,GY-56,3,16);glow(574,GY-58,40,'255,200,120',.35+.05*Math.sin(T*11))}
function S1(u,T){room(T);lamp(580,T);g.fillStyle='#3a2c22';g.fillRect(260,140,90,5);g.fillStyle='rgba(180,200,220,.25)';g.fillRect(290,118,20,22);g.fillStyle='#d8b050';for(let i=0;i<3;i++){g.beginPath();g.arc(296+i*6,136,2.5,0,7);g.fill()}glow(300,130,40,'255,220,130',.18+.1*Math.sin(T*3));
[[500,38,'#222838'],[575,42,'#2a3042'],[660,24,'#242a3a']].forEach(([x,h,c],i)=>{const b=Math.sin(T*.9+i)*1.2;g.fillStyle=c;g.fillRect(x-15,GY-38-h+b,30,h);g.beginPath();g.arc(x,GY-38-h-9+b,10,0,7);g.fill()});
g.fillStyle='#352a40';g.fillRect(465,GY-38,230,44);g.fillStyle='#41334f';g.fillRect(462,GY-50,236,14);chr(300,GY-6,'idle',T,Math.sin(T*.7)*.01)}
function S2(u,T){room(T);g.fillStyle='rgba(0,0,12,.4)';g.fillRect(-40,-40,W+80,H+40);const a=cl(u*1.6);glow(585,GY-110,230,'120,255,170',.08+.28*a);g.fillStyle='#3a4048';g.fillRect(470,GY-70,6,70);g.fillRect(690,GY-70,6,70);g.fillStyle='#cfd8dc';g.fillRect(455,GY-84,255,16);g.fillStyle='#5fa8d3';g.fillRect(462,GY-80,241,6);
for(let i=0;i<4;i++){g.save();g.translate(500+i*65,GY-84);g.globalAlpha=.5+.5*a;dP({x:0,y:-8,t:0,ph:i},T);g.restore()}
chr(300,GY-6,'idle',T,0);g.fillStyle='#9cf';g.fillRect(322,GY-36,9,15);glow(328,GY-30,120,'120,180,255',.3);if(u>.25){g.globalAlpha=cl((u-.25)*2.5);dP({x:330,y:GY-92+Math.sin(T*2)*3,t:0,ph:0},T);g.globalAlpha=1}}
